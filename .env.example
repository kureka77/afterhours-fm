# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# Nothing here is needed to play stations or identify tracks: ICY metadata comes
# from each stream itself, and Shazam recognition (via vibra) uses no API key.

# ── PostgreSQL (prod stack only) ─────────────────────────────────────────────
# Read by both the `db` and `prod` services in docker-compose.yml.
# Local dev needs none of this — it falls back to SQLite at ./app.db.
POSTGRES_PASSWORD=

# ── Database URL (optional override) ─────────────────────────────────────────
# Defaults to sqlite+aiosqlite:///./app.db when unset. docker-compose injects
# the Postgres URL for the prod service, so you normally leave this empty.
# DATABASE_URL=postgresql+asyncpg://afterhours_fm:<password>@db:5432/afterhours_fm

# ── Spotify (optional) ───────────────────────────────────────────────────────
# Enables the "Add to Spotify" button and cover art for ICY-sourced tracks.
# Without these, both degrade quietly — the app still works.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Copy the client ID and secret below
# 3. Run the authorization-code flow once with the `user-library-modify` scope
#    and store the resulting refresh token here. It is long-lived: you only do
#    this once, which is why the app needs no interactive login at runtime.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
